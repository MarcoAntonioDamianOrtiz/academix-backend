# academix-backend — variables de entorno
# Copia este archivo como .env y completa los valores reales.
# Nunca subas el .env real a git.

# Puerto donde escucha el servidor Express.
PORT=3000

# development | production | test
NODE_ENV=development

# Número de proxies de confianza entre el cliente y Express.
# Usa 0 en local. En producción configura únicamente los saltos reales.
TRUST_PROXY_HOPS=0

# Límites por IP. Auth se aplica adicionalmente a registro, login y
# recuperación de contraseña.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Orígenes autorizados para CORS, separados por comas y sin ruta.
# En desarrollo, academix-frontend corre normalmente en este puerto (Vite).
# Ejemplo con dos orígenes:
# FRONTEND_URL=http://localhost:5173,https://usuario.github.io
FRONTEND_URL=http://localhost:5173

# Proyecto Supabase de Academix.
SUPABASE_URL=https://kosvorqvtwbajfkyvsne.supabase.co

# Clave publicable moderna (sb_publishable_...). Se usa únicamente para
# operaciones de Auth que representan al usuario.
SUPABASE_PUBLISHABLE_KEY=

# Clave secreta moderna (sb_secret_...). Exclusiva del backend.
# Nunca debe copiarse al frontend ni confirmarse en Git.
SUPABASE_SECRET_KEY=

# URL completa permitida en Supabase Auth para volver al formulario del
# frontend después de abrir el correo de recuperación.
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/CursosWeb/
