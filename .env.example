# academix-backend — variables de entorno
# Copia este archivo como .env y completa los valores reales.
# Nunca subas el .env real a git.

# Puerto donde escucha el servidor Express.
PORT=3000

# development | production | test
NODE_ENV=development

# URL exacta del frontend autorizado para CORS (sin slash final).
# En desarrollo, academix-frontend corre normalmente en este puerto (Vite).
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------
# Variables de Supabase: se agregan en la Fase 5, cuando conectemos
# la base de datos. Todavía no se usan en el código de esta fase.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
